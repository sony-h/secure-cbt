{
  "name": "secure-cbt-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Secure CBT Platform - Cloud-based Computer Based Test system for Indonesian schools",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean",
    "db:migrate": "pnpm --filter @secure-cbt/backend run db:migrate",
    "db:generate": "pnpm --filter @secure-cbt/backend run db:generate",
    "db:seed": "pnpm --filter @secure-cbt/backend run db:seed",
    "db:studio": "pnpm --filter @secure-cbt/backend run db:studio"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
