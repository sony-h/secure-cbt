# ── Build Stage (compiles TypeScript) ──────────────────────────
FROM node:22-alpine AS build

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

# Copy workspace config (changes infrequently — cached layer)
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY tsconfig.json .eslintrc.js .prettierrc ./

# Copy source metadata
COPY packages/shared/package.json packages/shared/tsconfig.json packages/shared/
COPY apps/backend/package.json apps/backend/tsconfig.json apps/backend/nest-cli.json apps/backend/

# Install ALL dependencies (including devDeps for build)
RUN pnpm install --frozen-lockfile

# Copy shared source
COPY packages/shared/src/ packages/shared/src/

# Build shared library
RUN cd packages/shared && npx tsc

# Copy Prisma schema + backend source
COPY apps/backend/prisma/ apps/backend/prisma/
COPY apps/backend/src/ apps/backend/src/

# Generate Prisma client
RUN cd apps/backend && npx prisma generate

# Compile backend (tsc, not NestJS CLI — lighter)
RUN cd apps/backend && npx tsc

# ── Production Dependencies Stage ──────────────────────────────
FROM node:22-alpine AS prod-deps

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/backend/package.json apps/backend/

# Install only production dependencies
RUN pnpm install --frozen-lockfile --prod

# ── Production Runtime Stage ───────────────────────────────────
FROM node:22-alpine AS production

WORKDIR /app

# Copy runtime dependencies from prod-deps stage
COPY --from=prod-deps /app/node_modules ./node_modules

# Copy compiled output from build stage
COPY --from=build /app/apps/backend/dist ./apps/backend/dist
COPY --from=build /app/apps/backend/prisma ./apps/backend/prisma
COPY --from=build /app/packages/shared/dist ./packages/shared/dist

# Copy Prisma client (generated in node_modules)
COPY --from=build /app/node_modules/.pnpm/@prisma+client*/node_modules/@prisma/client ./node_modules/@prisma/client

# Copy package.json for startup scripts
COPY apps/backend/package.json ./apps/backend/

# Expose port
EXPOSE 3000

# Set environment
ENV NODE_ENV=production

# Start
CMD ["node", "apps/backend/dist/main.js"]

# ── Development Stage ──────────────────────────────────────────
FROM node:22-alpine AS development

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY tsconfig.json .eslintrc.js .prettierrc ./

COPY packages/shared/package.json packages/shared/tsconfig.json packages/shared/
COPY packages/shared/src/ packages/shared/src/
COPY apps/backend/package.json apps/backend/tsconfig.json apps/backend/nest-cli.json apps/backend/

RUN pnpm install --frozen-lockfile

COPY apps/backend/prisma/ apps/backend/prisma/
COPY apps/backend/src/ apps/backend/src/

RUN cd apps/backend && npx prisma generate

EXPOSE 3000

# Hot-reload development server
CMD ["pnpm", "--filter", "@secure-cbt/backend", "dev"]
