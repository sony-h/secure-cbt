# ── Next.js Production Environment Variables ─────────────────
# IMPORTANT: NEXT_PUBLIC_* variables are inlined at build time ('next build').
# Update these before running 'pnpm run build' on your VPS.

# Public API URL accessible from students' & teachers' browsers
NEXT_PUBLIC_API_URL=https://api.domainanda.com/api/v1

# Public WebSocket URL for real-time exam monitoring
NEXT_PUBLIC_SOCKET_URL=https://api.domainanda.com
