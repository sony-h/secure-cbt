PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/secure_cbt?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=dev-access-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=secure-cbt

# Email Service (Resend)
# Dapatkan API Key di https://resend.com/api-keys
# Jika dikosongkan pada mode dev, email akan dicetak ke console terminal
RESEND_API_KEY=
# Sandbox: 'Assessia <onboarding@resend.dev>' (hanya bisa kirim ke email terdaftar di Resend)
# Production: 'Assessia <noreply@domainanda.sch.id>' (setelah domain diverifikasi di Resend)
EMAIL_FROM=Assessia <onboarding@resend.dev>

# App
APP_NAME=Assessia
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001
