# ── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
APP_NAME=Assessia
APP_URL=https://api.sonyhartono.web.id

# Allowed CORS origins (comma-separated if multiple, e.g. web domain + direct IP)
CORS_ORIGIN=https://cbt.domainanda.com,https://api.domainanda.com

# ── Database ────────────────────────────────────────────────
# Connects to PostgreSQL container mapped to 127.0.0.1:5432
DATABASE_URL="postgresql://postgres:GANTI_DENGAN_PASSWORD_DATABASE_KUAT@localhost:5432/secure_cbt?schema=public"

# ── Redis & Queues ──────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=GANTI_DENGAN_PASSWORD_REDIS_KUAT

BULLMQ_REDIS_HOST=localhost
BULLMQ_REDIS_PORT=6379
BULLMQ_REDIS_PASSWORD=GANTI_DENGAN_PASSWORD_REDIS_KUAT

# ── Security & JWT Secrets ──────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=GANTI_DENGAN_STRING_ACAK_SANGAT_PANJANG_1
JWT_REFRESH_SECRET=GANTI_DENGAN_STRING_ACAK_SANGAT_PANJANG_2

# ── MinIO / S3 Storage ──────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=cbt_minio_admin
MINIO_SECRET_KEY=GANTI_DENGAN_PASSWORD_MINIO_KUAT
MINIO_BUCKET=secure-cbt
MINIO_USE_SSL=false

# ── Email Service (Resend) ──────────────────────────────────
# Dapatkan API Key di https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
# Production: Wajib gunakan domain yang telah diverifikasi di dashboard Resend
EMAIL_FROM=Assessia <noreply@sonyhartono.web.id>
# URL Dashboard Frontend untuk tautan aksi di dalam email (verifikasi, invite, reset password)
FRONTEND_URL=https://cbt.sonyhartono.web.id

# ── Socket.io Monitoring ────────────────────────────────────
SOCKET_IO_CORS_ORIGIN=https://cbt.sonyhartono.web.id

# ── Rate Limiting ───────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=120
TZ=Asia/Jakarta
